#!/usr/bin/env bash
set -euo pipefail

TV_IP="${1:-192.168.0.73}"
PORT="${PORT:-8008}"
WORKDIR="${WORKDIR:-/tmp/lg-ut640s-hbc-installer}"

need() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "Missing required command: $1" >&2
        exit 1
    }
}

need curl
need python3
need ip

LOCAL_IP="${LOCAL_IP:-$(ip -4 route get "$TV_IP" | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}')}"
if [ -z "$LOCAL_IP" ]; then
    echo "Could not determine local IP for route to $TV_IP; set LOCAL_IP=x.x.x.x" >&2
    exit 1
fi

rm -rf "$WORKDIR"
mkdir -p "$WORKDIR"/{css,files,lib}

fetch() {
    local url="$1" out="$2"
    curl -L --retry 8 --retry-all-errors --connect-timeout 20 --fail --silent --show-error "$url" -o "$out"
}

echo "Preparing local RootMyTV force-v2 mirror in $WORKDIR"
fetch https://rootmy.tv/stage1.html "$WORKDIR/stage1.html"
fetch https://rootmy.tv/css/common.css "$WORKDIR/css/common.css"
fetch https://rootmy.tv/lib/webOSTV.js "$WORKDIR/lib/webOSTV.js"
fetch https://rootmy.tv/files/jumpstart.sh "$WORKDIR/files/jumpstart.sh"
fetch https://rootmy.tv/files/stage3.sh "$WORKDIR/files/stage3.sh"
fetch https://rootmy.tv/files/dummy "$WORKDIR/files/dummy"

echo "Downloading latest Homebrew Channel IPK"
HB_URL="$(python3 - <<'PY'
import json, urllib.request
with urllib.request.urlopen("https://api.github.com/repos/webosbrew/webos-homebrew-channel/releases/latest", timeout=30) as r:
    rel = json.load(r)
for asset in rel.get("assets", []):
    name = asset.get("name", "")
    if name.endswith("_all.ipk") or name.endswith(".ipk"):
        print(asset["browser_download_url"])
        break
else:
    raise SystemExit("No IPK asset found")
PY
)"
fetch "$HB_URL" "$WORKDIR/files/hbchannel.ipk"

cat > "$WORKDIR/stage2-force-v2-log.html" <<'HTML'
<!DOCTYPE html>
<html><head><title>RootMyTV force v2</title><link rel="stylesheet" href="css/common.css" /></head>
<body><header><h1>RootMy.TV<small> force v2</small></h1></header><hr><section class="content-center"><article><pre id="log"></pre></article></section><hr>
<script src="lib/webOSTV.js"></script>
<script>
function log(str){var b=document.querySelector('#log'); b.innerText+=str+'\n'; b.scrollIntoView(false); try{(new Image()).src='/rmtvlog?m='+encodeURIComponent(str).slice(0,1500)+'&t='+Date.now();}catch(e){}}
window.onerror=function(err){log('Unexpected error: '+err);};
(function(){
 function download(url,targetDir,targetFilename,success,failure){
  var target=new URL(url,window.location.href).href;
  log(targetFilename+': Downloading from '+target+' to '+targetDir+' ...');
  webOS.service.request('luna://com.webos.service.downloadmanager',{method:'download',parameters:{target:target,targetDir:targetDir,targetFilename:targetFilename,subscribe:true},onSuccess:function(res){
   log(targetFilename+': result '+JSON.stringify(res));
   if(res.completed===true){
    if(res.destPath!==targetDir){ log(targetFilename+': destPath mismatch '+res.destPath+' expected '+targetDir); if(failure)failure(res); }
    else if(res.httpStatus!==200){ log(targetFilename+': HTTP '+res.httpStatus); if(failure)failure(res); }
    else { log(targetFilename+': Download completed'); success(); }
   }
  },onFailure:function(err){log(targetFilename+': Luna call failed '+JSON.stringify(err)); if(failure)failure(err);}});
 }
 function reboot(){webOS.service.request('luna://com.webos.service.sleep',{method:'shutdown/machineReboot',parameters:{reason:'remoteKey'},onSuccess:function(r){log('Reboot request succeeded '+JSON.stringify(r));},onFailure:function(e){log('Failed to reboot '+JSON.stringify(e));}});}
 log('Forcing RootMyTV v2 WAM extra_conf path; skipping old devmode hook.');
 download('files/jumpstart.sh','/mnt/lg/cmn_data/wam/','extra_conf.sh',function(){
  download('files/stage3.sh','/mnt/lg/cmn_data/var/lib/webosbrew/','startup.sh',function(){
   download('files/hbchannel.ipk','/mnt/lg/appstore/internal/downloads/','hbchannel.ipk',function(){
    download('files/dummy','/mnt/lg/cmn_data/var/luna/preferences/','devmode_enabled',function(){
     log('Force-v2 payload staged. Reboot in 5 seconds...'); setTimeout(reboot,5000);
    });
   });
  });
 });
})();
</script></body></html>
HTML

python3 - "$WORKDIR" <<'PY'
