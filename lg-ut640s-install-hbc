SERVER_LOG="$WORKDIR/server.log"
ROOTMYTV_DIR="$WORKDIR" ROOTMYTV_PORT="$PORT" python3 "$WORKDIR/server.py" >"$SERVER_LOG" 2>&1 &
SERVER_PID=$!
cleanup() {
    kill "$SERVER_PID" >/dev/null 2>&1 || true
}
trap cleanup EXIT
sleep 1

echo "Serving installer at: http://$LOCAL_IP:$PORT/stage1-auto-force-v2.html"
echo "Launching on TV $TV_IP. Accept any pairing prompt if shown."

python3 - "$TV_IP" "$LOCAL_IP" "$PORT" <<'PY'
import base64, json, os, socket, struct, sys, time

host, local_ip, port = sys.argv[1], sys.argv[2], int(sys.argv[3])
target_url = f"http://{local_ip}:{port}/stage1-auto-force-v2.html"
perms = ["LAUNCH", "LAUNCH_WEBAPP", "APP_TO_APP", "WRITE_NOTIFICATION_TOAST", "READ_INSTALLED_APPS"]
manifest = {
    "manifestVersion": 1,
    "appVersion": "1.1",
    "signed": {
        "created": "20260714",
        "appId": "com.github.copilot.cli.ut640s",
        "vendorId": "com.github",
        "localizedAppNames": {"": "UT640S HBC Installer"},
        "localizedVendorNames": {"": "GitHub"},
        "permissions": perms,
    },
    "permissions": perms,
}

def ws_connect():
    key = base64.b64encode(os.urandom(16)).decode()
    s = socket.socket()
    s.settimeout(10)
    s.connect((host, 3000))
    req = (
        f"GET / HTTP/1.1\r\nHost: {host}:3000\r\nUpgrade: websocket\r\n"
        f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
        "Sec-WebSocket-Version: 13\r\nOrigin: null\r\n\r\n"
    )
    s.sendall(req.encode())
    data = b""
    while b"\r\n\r\n" not in data:
        data += s.recv(4096)
    return s

def send(s, obj):
    data = json.dumps(obj, separators=(",", ":")).encode()
    h = bytearray([0x81])
    n = len(data)
    if n < 126:
        h.append(0x80 | n)
    elif n < 65536:
        h += bytes([0x80 | 126]) + struct.pack("!H", n)
    else:
        h += bytes([0x80 | 127]) + struct.pack("!Q", n)
    mask = os.urandom(4)
    h += mask
    s.sendall(h + bytes(b ^ mask[i % 4] for i, b in enumerate(data)))

def recv(s, timeout=8):
    s.settimeout(timeout)
    h = s.recv(2)
    if not h:
        return None
    b1, b2 = h
    ln = b2 & 127
    if ln == 126:
        ln = struct.unpack("!H", s.recv(2))[0]
    elif ln == 127:
        ln = struct.unpack("!Q", s.recv(8))[0]
    mask = s.recv(4) if b2 & 128 else None
    data = b""
    while len(data) < ln:
        data += s.recv(ln - len(data))
    if mask:
        data = bytes(x ^ mask[i % 4] for i, x in enumerate(data))
    return data.decode("utf-8", "replace")

s = ws_connect()
send(s, {"type": "register", "id": "reg", "payload": {"pairingType": "PROMPT", "manifest": manifest}})
registered = False
end = time.time() + 75
while time.time() < end:
    try:
        msg = recv(s, 5)
    except Exception:
        print("waiting for pairing...")
        continue
    print(msg)
    if msg and '"type":"registered"' in msg:
        registered = True
        break
if not registered:
    raise SystemExit("TV did not register. Make sure it is on and accept any pairing prompt.")

send(s, {
    "type": "request",
    "id": "launch",
    "uri": "ssap://system.launcher/launch",
    "payload": {"id": "com.webos.app.browser", "params": {"target": target_url}},
})
print(recv(s, 10))
s.close()
PY

echo
echo "Streaming TV installer logs for 150 seconds..."
echo "Look for: Force-v2 payload staged / Reboot request succeeded"
timeout 150 tail -n +1 -f "$SERVER_LOG" || true

echo
echo "If Homebrew Channel does not appear, power-cycle the TV and retry launching it after 1-2 minutes."
