    window.addEventListener('load', function(){
      setTimeout(function(){
        try { begin_exploit(); } catch(e) { alert('auto start failed: ' + e); }
      }, 1500);
    });
"""
s = s.replace("    /* slider animation logic */", insert + "\n    /* slider animation logic */")
(root / "stage1-auto-force-v2.html").write_text(s)
